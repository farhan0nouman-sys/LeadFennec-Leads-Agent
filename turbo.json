{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "concurrency": "20",
  "tasks": {
    "generate": {
      "inputs": ["prisma/schema.prisma", "prisma.config.mjs"],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "generate"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "generate"]
    },
    "lint": {
      "dependsOn": ["^build", "generate"]
    },
    "test": {
      "dependsOn": ["^build", "generate"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/vitest.shared.mjs"],
      "env": ["TEST_DATABASE_URL", "TEST_REDIS_URL"]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false,
      "passThroughEnv": ["CI", "PLAYWRIGHT_BROWSERS_PATH"]
    },
    "dev": {
      "dependsOn": ["^build", "generate"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "APP_ENV",
        "LOG_LEVEL",
        "API_PORT",
        "API_BASE_URL",
        "DATABASE_URL",
        "REDIS_URL",
        "WORKER_HEALTH_PORT",
        "HEALTH_CHECK_TIMEOUT_MS"
      ]
    }
  }
}
