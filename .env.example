# Lead Fennec AI: local development environment.
#
# Copy this file to .env (git-ignored), then replace every "replace-with-..." value:
#   cp .env.example .env
#
# Every value here is a FAKE PLACEHOLDER. Never put real credentials or provider keys in
# this file. Variables already exported in your shell take precedence over .env.
# Reference: docs/local-development.md

# --- Environment -------------------------------------------------------------
# development | test | staging | production
APP_ENV=development

# --- Local services (compose.yaml) -------------------------------------------
POSTGRES_USER=leadfennec
POSTGRES_PASSWORD=replace-with-local-postgres-password
POSTGRES_DB=leadfennec
POSTGRES_PORT=5432

REDIS_PASSWORD=replace-with-local-redis-password
REDIS_PORT=6379

# --- API and worker ----------------------------------------------------------
# Must match the POSTGRES_* and REDIS_* values above (user, password, port, database).
DATABASE_URL=postgresql://leadfennec:replace-with-local-postgres-password@127.0.0.1:5432/leadfennec
REDIS_URL=redis://:replace-with-local-redis-password@127.0.0.1:6379/0

API_PORT=3001
WORKER_HEALTH_PORT=3002
# Structured JSON logs: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Per-dependency timeout for readiness checks, 100-30000 ms.
HEALTH_CHECK_TIMEOUT_MS=2000

# --- Web ---------------------------------------------------------------------
# Server-side only (not NEXT_PUBLIC_): the web server uses it to call the API.
API_BASE_URL=http://127.0.0.1:3001

# --- Tests (reference only) --------------------------------------------------
# Tests never read .env. To run the real-database integration tests locally, export
# these in your shell (CI sets them). compose.yaml creates <POSTGRES_DB>_test on first
# start; tests refuse any database not ending in "_test" and Redis database 0.
#   TEST_DATABASE_URL=postgresql://leadfennec:replace-with-local-postgres-password@127.0.0.1:5432/leadfennec_test
#   TEST_REDIS_URL=redis://:replace-with-local-redis-password@127.0.0.1:6379/15
